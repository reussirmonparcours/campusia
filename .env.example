# ==============================================================================
# MonParcours — Environment Variables Template
# ==============================================================================
# Duplicate this file to .env.local for local development.
# NEVER commit .env or .env.local to Git.
#
# IMPORTANT: Supabase used for MonParcours MUST be a dedicated project,
# not shared with any other applications.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to the browser via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------

# The URL of your Supabase project instance (e.g., https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# The anonymous public API key for Supabase (Safe for browser usage with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY VARIABLES (NEVER exposed to the browser - strictly confidential)
# ------------------------------------------------------------------------------

# Supabase Service Role Key: Bypasses Row Level Security (RLS).
# CRITICAL SECURITY NOTE:
# - Used ONLY by src/lib/supabase/admin.ts on the server.
# - NEVER import or reference this variable in client components.
# - Do not use this key for standard user operations.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# (Optional / Future Milestones): Server AI Provider API Key
# Will be configured in a dedicated milestone when the server LLM pipeline is implemented.
# AI_API_KEY=""
